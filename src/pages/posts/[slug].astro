---
import { urlFor } from '../../lib/sanity';         
import Layout from '../../layouts/Layout.astro';
import ShareButton from '../../components/ShareButton.astro';
import ArticleBody from '../../components/ArticleBody.astro'; 
import { sanityClient } from "sanity:client";
import PortableTextWrapper from '../../components/PortableTextWrapper.jsx';

// MEMBERITAHU ASTRO BAHWA HALAMAN INI HARUS DI-BUILD MENJADI STATIS
export const prerender = true;

export async function getStaticPaths() {
  const posts = await sanityClient.fetch(`*[_type == "post" && defined(slug.current)]{ "slug": slug.current }`);
  return posts.map((post: any) => ({ params: { slug: post.slug } }));
}

const { slug } = Astro.params;

const post = await sanityClient.fetch(
  `*[_type == "post" && slug.current == $slug][0]{  
    title, publishedAt, 
    body[] {  
        ..., 
        _type == "bacaJuga" => { 
            _type,
            "post": post->{title, slug} 
        },
        _type == "image" => { ..., "alt": alt },
        _type == "stockChart" => { ... } 
    },
    excerpt, 
    "imageUrl": image.asset->url,
    "imageAlt": image.alt,
    "authors": authors[]->{name, role, "imageUrl": image.asset->url}
  }`,
  { slug }
);

const morePosts = await sanityClient.fetch(
  `*[_type == "post" && slug.current != $slug] | order(publishedAt desc)[0...3]{
    title, "slug": slug.current, "imageUrl": image.asset->url, "imageAlt": image.alt, publishedAt
  }`,
  { slug }
);

const popularPosts = await sanityClient.fetch(
  `*[_type == "post"] | order(publishedAt desc)[0...5]{
    title, "slug": slug.current, "imageUrl": image.asset->url, "imageAlt": image.alt
  }`
);

if (!post) return Astro.redirect('/404');
---

<Layout 
  title={post.title} 
  description={post.excerpt || `Baca artikel selengkapnya tentang ${post.title} di RWAdaily.`}
  image={post.imageUrl}
>
  <main class="max-w-7xl mx-auto py-6 md:py-12 px-0 md:px-6 grid lg:grid-cols-3 gap-8">
    
    <div class="lg:col-span-2">
      <article class="prose max-w-none bg-white px-4 py-8 md:p-10 md:rounded-2xl md:shadow-sm md:border border-gray-200">
        
        <h1 class="text-3xl md:text-5xl font-extrabold mb-6 leading-[1.2] text-gray-900">{post.title}</h1>
        
        <div class="flex flex-wrap items-center justify-between gap-4 py-4 border-y border-gray-100 mb-8">
          <div class="flex items-center gap-4 text-gray-500 font-medium">
            {post.authors?.map((author: any) => (
              <div class="flex items-center gap-2">
                {author.imageUrl && <img src={`${author.imageUrl}?w=100&fm=webp`} alt={author.name} class="w-8 h-8 rounded-full object-cover" />}
                <div class="flex flex-col">
                  <span class="text-sm font-bold text-gray-800">{author.name}</span>
                  <span class="text-[10px] uppercase tracking-widest text-gray-400">{author.role}</span>
                </div>
              </div>
            ))}
          </div>
          <p class="text-sm text-gray-400">
            {new Date(post.publishedAt).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })}
          </p>
        </div>

        {post.imageUrl && (
          <img 
            src={`${post.imageUrl}?w=1200&auto=format&fm=webp`} 
            alt={post.imageAlt || post.title} 
            fetchpriority="high"
            class="w-full h-auto rounded-none md:rounded-xl mb-10 md:shadow-md" 
          />
        )}
        
        <ArticleBody>
          <PortableTextWrapper body={post.body} client:load />
        </ArticleBody>

        {/* Disclaimer */}
        <div class="mt-12 mb-10 p-6 border-2 border-yellow-400 bg-yellow-50 rounded-none md:rounded-xl">
          <div class="flex items-center gap-3 mb-3">
            <svg class="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
            <h4 class="text-xs font-black text-yellow-800 uppercase tracking-widest">Disclaimer</h4>
          </div>
          <p class="text-sm text-yellow-900 leading-relaxed font-medium">
            Konten ini bersifat edukatif dan bukan saran investasi keuangan. Pasar crypto sangat volatil. Selalu lakukan riset mandiri (DYOR).
          </p>
        </div>

        {/* Share Button */}
        <div class="my-10 flex justify-center"><ShareButton /></div>
        
        {/* More Posts */}
        {morePosts.length > 0 && (
          <div class="mt-16 border-t pt-12 px-4 md:px-0">
            <h2 class="text-2xl font-bold text-gray-900 mb-8">Jelajahi Berita Lainnya</h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
              {morePosts.map((p: any) => (
                <a href={`/posts/${p.slug}`} class="group block">
                  <div class="overflow-hidden rounded-lg mb-3 bg-gray-100">
                    <img 
                      src={`${p.imageUrl}?w=400&auto=format&fm=webp`} 
                      alt={p.imageAlt || p.title} 
                      loading="lazy"
                      class="w-full h-40 object-cover transition-transform duration-300 group-hover:scale-105" 
                    />
                  </div>
                  <h3 class="font-semibold text-gray-800 group-hover:text-yellow-600 transition-colors">{p.title}</h3>
                </a>
              ))}
            </div>
          </div>
        )}
      </article>
    </div>

    {/* Sidebar Desktop */}
    <aside class="hidden lg:block lg:col-span-1 px-4 lg:px-0">
      <div class="sticky top-24 space-y-8">
        <div class="bg-white p-6 rounded-none md:rounded-2xl shadow-sm border border-gray-200">
          <h2 class="text-xl font-bold text-gray-900 mb-6 border-b border-yellow-400 pb-4">Terpopuler</h2>
          <div class="space-y-6">
            {popularPosts.map((p: any) => (
              <a href={`/posts/${p.slug}`} class="flex gap-4 group items-center">
                <img 
                  src={`${p.imageUrl}?w=150&auto=format&fm=webp`} 
                  alt={p.imageAlt || p.title} 
                  loading="lazy"
                  class="w-16 h-16 rounded-lg object-cover shrink-0" 
                />
                <h3 class="text-sm font-semibold text-gray-800 group-hover:text-yellow-600 transition-colors leading-snug line-clamp-2">{p.title}</h3>
              </a>
            ))}
          </div>
        </div>
      </div>
    </aside>
  </main>
</Layout>