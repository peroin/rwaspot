---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import AdsterraBanner from '../../components/AdsterraBanner.astro';
import ShareButton from '../../components/ShareButton.astro';
import AdWrapper from '../../components/IklanWrapper.astro'; 
import ArticleBody from '../../components/ArticleBody.astro'; 
import { sanityClient } from "sanity:client";
import { urlFor } from '../../lib/sanity'; // Pastikan path ini benar
import ReadMore from '../../components/ReadMore.astro';

export async function getStaticPaths() {
  const posts = await sanityClient.fetch(`*[_type == "post" && defined(slug.current)]{ "slug": slug.current }`);
  return posts.map((post: any) => ({ params: { slug: post.slug } }));
}

const { slug } = Astro.params;

const post = await sanityClient.fetch(
  `*[_type == "post" && slug.current == $slug][0]{  
    title, publishedAt, 
    body[] {  
        ..., 
        _type == "bacaJuga" => { 
            _type,
            "post": post->{title, slug} 
        },
        _type == "image" => { ..., "alt": alt } 
    },
    excerpt, 
    "imageUrl": image.asset->url,
    "imageAlt": image.alt,
    "authors": authors[]->{name, role, "imageUrl": image.asset->url}
  }`,
  { slug }
);

const morePosts = await sanityClient.fetch(
  `*[_type == "post" && slug.current != $slug] | order(publishedAt desc)[0...3]{
    title, "slug": slug.current, "imageUrl": image.asset->url, "imageAlt": image.alt, publishedAt
  }`,
  { slug }
);

const popularPosts = await sanityClient.fetch(
  `*[_type == "post"] | order(publishedAt desc)[0...5]{
    title, "slug": slug.current, "imageUrl": image.asset->url, "imageAlt": image.alt
  }`
);

if (!post) return Astro.redirect('/404');
---

<Layout 
  title={post.title} 
  description={post.excerpt || `Baca artikel selengkapnya tentang ${post.title} di RWASpot.`}
  image={post.imageUrl}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org", "@type": "NewsArticle",
      "headline": post.title, "image": [post.imageUrl], "datePublished": post.publishedAt,
      "author": post.authors?.map((author: any) => ({ "@type": "Person", "name": author.name, "jobTitle": author.role }))
    })}></script>
  </Fragment>

  <main class="max-w-6xl mx-auto py-12 px-4 grid lg:grid-cols-3 gap-8">
    <div class="lg:col-span-2">
      <article class="bg-white p-6 md:p-12 rounded-2xl shadow-sm border border-gray-200">
        <h1 class="text-4xl md:text-5xl font-extrabold mb-6 leading-tight text-gray-900">{post.title}</h1>
        
        <div class="flex items-center gap-6 text-gray-500 mb-8 font-medium">
          {post.authors?.map((author: any) => (
            <div class="flex items-center gap-2">
              {author.imageUrl && <img src={`${author.imageUrl}?w=100&fm=webp`} alt={author.name} class="w-8 h-8 rounded-full object-cover" />}
              <div class="flex flex-col">
                <span class="text-sm font-bold text-gray-800">{author.name}</span>
                <span class="text-[10px] uppercase tracking-widest text-gray-400">{author.role}</span>
              </div>
            </div>
          ))}
          <span class="text-gray-300">•</span>
          <p class="text-sm">{new Date(post.publishedAt).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })}</p>
        </div>

        {post.imageUrl && (
          <img 
            src={`${post.imageUrl}?w=1000&auto=format&fm=webp`} 
            alt={post.imageAlt || post.title} 
            fetchpriority="high"
            class="w-full h-auto rounded-xl mb-10 shadow-md" 
          />
        )}
        
        <ArticleBody>
          {post.body?.map((block: any) => {
            if (block._type === 'bacaJuga') return <ReadMore node={block} />;
            
            // PERBAIKAN: Gambar menggunakan urlFor agar teroptimasi & tidak pecah
            if (block._type === 'image' && block.asset) {
              return (
                <figure class="my-8">
                  <img 
                    src={urlFor(block.asset).width(800).auto('format').url()} 
                    alt={block.alt || 'Gambar artikel'} 
                    class="rounded-xl w-full h-auto object-contain"
                    loading="lazy"
                  />
                </figure>
              );
            }
            
            if (block._type === 'block') {
              return (
                <p class="mb-5 text-lg text-gray-700 leading-relaxed">
                  {block.children?.map((child: any) => {
                    const mark = block.markDefs?.find((m: any) => child.marks?.includes(m._key));
                    if (mark && mark._type === 'link') {
                      return (
                        <a href={mark.href} target="_blank" rel="noopener noreferrer" class="text-red-600 font-semibold hover:underline">
                          {child.text}
                        </a>
                      );
                    }
                    return child.text;
                  })}
                </p>
              );
            }
            return null;
          })}
        </ArticleBody>

        <div class="mt-12 mb-8 p-5 border-2 border-red-600 bg-red-50 rounded-xl">
          <div class="flex items-center gap-3 mb-2">
            <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
            <h4 class="text-sm font-black text-red-700 uppercase tracking-widest">Peringatan Risiko / Disclaimer</h4>
          </div>
          <p class="text-sm text-red-900 leading-relaxed font-medium">
            Konten ini bersifat informasi edukatif semata dan <strong>bukan merupakan saran investasi keuangan</strong>. Pasar aset kripto memiliki volatilitas tinggi. Selalu lakukan riset mandiri (DYOR) sebelum mengambil keputusan investasi.
          </p>
        </div>

        <div class="my-10 flex justify-center"><ShareButton /></div>
        
        {morePosts.length > 0 && (
          <div class="mt-16 border-t pt-12">
            <h2 class="text-2xl font-bold text-gray-900 mb-8">Jelajahi Berita Lainnya</h2>
            <div class="grid md:grid-cols-3 gap-6">
              {morePosts.map((p: any) => (
                <a href={`/posts/${p.slug}`} class="group block">
                  <div class="overflow-hidden rounded-lg mb-3 bg-gray-100">
                    <img 
                      src={`${p.imageUrl}?w=400&auto=format&fm=webp`} 
                      alt={p.imageAlt || p.title} 
                      loading="lazy"
                      class="w-full h-40 object-cover transition-transform duration-300 group-hover:scale-105" 
                    />
                  </div>
                  <h3 class="font-semibold text-gray-800 group-hover:text-red-600 transition-colors">{p.title}</h3>
                </a>
              ))}
            </div>
          </div>
        )}
      </article>
    </div>

    <aside class="lg:col-span-1">
      <div class="sticky top-8 space-y-8">
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-200">
          <h2 class="text-xl font-bold text-gray-900 mb-6 border-b pb-4">Terpopuler</h2>
          <div class="space-y-6">
            {popularPosts.map((p: any) => (
              <a href={`/posts/${p.slug}`} class="flex gap-4 group items-center">
                <img 
                  src={`${p.imageUrl}?w=150&auto=format&fm=webp`} 
                  alt={p.imageAlt || p.title} 
                  loading="lazy"
                  class="w-16 h-16 rounded-lg object-cover shrink-0" 
                />
                <h3 class="text-sm font-semibold text-gray-800 group-hover:text-red-600 transition-colors leading-snug line-clamp-2">{p.title}</h3>
              </a>
            ))}
          </div>
        </div>
      </div>
    </aside>
  </main>
</Layout>