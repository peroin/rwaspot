---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import { client } from '../../lib/sanity';

const getOptimizedImageUrl = (url: string, width = 800, height = 500) => 
  url ? `${url}?w=${width}&h=${height}&fit=crop&auto=format&q=80` : '';

const formatDate = (date: string) => {
  return new Date(date).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
};

export async function getStaticPaths() {
  return [{ params: { category: 'dunia' } }, { params: { category: 'crypto' } }, { params: { category: 'rwa' } }, { params: { category: 'price' } }];
}

const { category } = Astro.params;

const posts = await client.fetch(
  `*[_type == "post" && category == $category]|order(publishedAt desc)[0...10]{
    title, slug, publishedAt, 
    "imageUrl": image.asset->url,
    "authorName": authors[0]->name,
    excerpt,
    "bodyText": pt::text(body)
  }`, 
  { category }
);

const trending = await client.fetch(
  `*[_type == "post"]|order(publishedAt desc)[0...5]{title, slug, "imageUrl": image.asset->url}`
);

const topTrending = trending[0];
const otherTrending = trending.slice(1, 5);

const heroPost = posts[0];
const gridPosts = posts.slice(1, 3);
const bottomPosts = posts.slice(3, 6);
const listPosts = posts.slice(6, 10);

const categoryDesc = {
  dunia: "Semua tentang dunia terkini dan peristiwa global.",
  crypto: "Semua tentang dunia aset kripto dan blockchain.",
  rwa: "Semua tentang dunia aset dunia nyata (Real World Assets).",
  price: "Semua tentang dunia pergerakan harga dan analisis pasar."
}[category] || "Berita terbaru seputar topik ini.";
---

<Layout title={`Berita ${category.charAt(0).toUpperCase() + category.slice(1)}`} description={`Berita terbaru seputar ${category}`}>
  <main class="max-w-[1400px] mx-auto py-10 px-4 md:px-6">
    
    <header class="mb-10 border-b border-gray-200 pb-6">
      <h1 class="text-2xl font-semibold text-gray-700 capitalize">Berita {category}</h1>
      <p class="text-gray-500 mt-2 text-md">{categoryDesc}</p>
    </header>

    {/* GRID UTAMA - Dibuat responsif dengan grid-cols-1 dan lg:grid-cols-3 */}
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-12 mb-16">
      
      {/* Kolom Kiri - Utama */}
      <div class="lg:col-span-2 space-y-12">
        {heroPost && (
          <article class="group">
            <a href={`/posts/${heroPost.slug?.current}`} class="relative block w-full h-[300px] md:h-[400px] rounded-xl overflow-hidden bg-gray-900">
              <img src={getOptimizedImageUrl(heroPost.imageUrl, 1200, 800)} alt={heroPost.title} class="w-full h-full object-cover opacity-70 transition-transform duration-700 group-hover:scale-105" />
              <div class="absolute bottom-0 left-0 p-6 md:p-8 w-full bg-gradient-to-t from-black/90 to-transparent">
                <h2 class="text-2xl md:text-3xl font-bold text-white leading-tight">{heroPost.title}</h2>
                <p class="text-xs md:text-sm text-gray-300 mt-2">{heroPost.authorName || 'Admin'} • {formatDate(heroPost.publishedAt)}</p>
              </div>
            </a>
          </article>
        )}

        <div class="grid md:grid-cols-2 gap-8">
          {gridPosts.map((post: any) => (
            <article class="group">
              <a href={`/posts/${post.slug?.current}`} class="block aspect-video overflow-hidden rounded-lg mb-4 bg-gray-100">
                <img src={getOptimizedImageUrl(post.imageUrl, 600, 400)} alt={post.title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
              </a>
              <a href={`/posts/${post.slug?.current}`} class="text-lg font-bold text-black leading-snug group-hover:underline">{post.title}</a>
              <p class="text-xs text-gray-500 mt-1">{post.authorName || 'Admin'} • {formatDate(post.publishedAt)}</p>
            </article>
          ))}
        </div>
      </div>

      {/* ASIDE TRENDING - Menjadi pembatas bawah di mobile */}
      <aside class="space-y-10 lg:border-l lg:border-gray-200 lg:pl-12 border-t pt-10 lg:pt-0 border-gray-200">
        <section>
          <h3 class="text-sm font-bold uppercase tracking-widest text-black mb-6 pb-2 border-b-2 border-black inline-block">Trending Sekarang</h3>
          
          {topTrending && (
            <article class="group mb-8">
              <a href={`/posts/${topTrending.slug?.current}`} class="block aspect-video overflow-hidden rounded-lg mb-3 bg-gray-100">
                <img src={getOptimizedImageUrl(topTrending.imageUrl, 400, 250)} alt={topTrending.title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
              </a>
              <a href={`/posts/${topTrending.slug?.current}`} class="text-lg font-bold text-black leading-tight hover:underline">{topTrending.title}</a>
            </article>
          )}

          <ul class="space-y-6">
            {otherTrending.map((post: any, index: number) => (
              <li class="flex gap-4 group">
                <span class="text-xl font-bold text-gray-300">0{index + 2}</span>
                <a href={`/posts/${post.slug?.current}`} class="text-sm font-semibold text-gray-800 leading-tight hover:text-black hover:underline">{post.title}</a>
              </li>
            ))}
          </ul>
        </section>
      </aside>
    </div>

    <div class="w-full border-t border-gray-200 my-12"></div>

    {/* Artikel Full Width */}
    {bottomPosts.length > 0 && (
      <div class="mb-16">
        <div class="grid md:grid-cols-3 gap-8">
          {bottomPosts.map((post: any) => (
            <article class="group flex flex-col">
              <a href={`/posts/${post.slug?.current}`} class="block aspect-[4/3] overflow-hidden rounded-lg mb-4 bg-gray-100">
                <img src={getOptimizedImageUrl(post.imageUrl, 400, 300)} alt={post.title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" />
              </a>
              <a href={`/posts/${post.slug?.current}`} class="text-base font-bold text-black leading-snug group-hover:text-blue-600 transition-colors">{post.title}</a>
              <p class="text-xs text-gray-500 mt-1">{post.authorName || 'Admin'} • {formatDate(post.publishedAt)}</p>
            </article>
          ))}
        </div>
      </div>
    )}

    {/* List Artikel */}
    {listPosts.length > 0 && (
      <section class="border-t border-gray-200 pt-12">
        <h3 class="text-2xl font-bold mb-8">Pembaruan Terakhir</h3>
        <div class="max-w-4xl flex flex-col gap-0">
          {listPosts.map((post: any) => (
            <article class="flex flex-col md:flex-row gap-4 md:gap-6 items-start py-6 border-b border-gray-200 group">
              <a href={`/posts/${post.slug?.current}`} class="w-full md:w-40 h-40 md:h-24 flex-shrink-0 overflow-hidden rounded-md bg-gray-100">
                <img src={getOptimizedImageUrl(post.imageUrl, 300, 200)} alt={post.title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" />
              </a>
              <div class="flex flex-col">
                <a href={`/posts/${post.slug?.current}`} class="text-lg font-bold text-black leading-tight group-hover:text-blue-600 transition-colors">{post.title}</a>
                <p class="text-xs text-gray-400 mt-1 mb-2">{post.authorName || 'Admin'} • {formatDate(post.publishedAt)}</p>
                <p class="text-sm text-gray-600 line-clamp-2">
                  {post.excerpt || post.bodyText || "Baca berita selengkapnya di sini untuk mengetahui informasi lebih lanjut mengenai topik terkini."}
                </p>
              </div>
            </article>
          ))}
        </div>
      </section>
    )}
  </main>
</Layout>