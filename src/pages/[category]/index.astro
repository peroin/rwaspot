---
import Layout from '../../layouts/Layout.astro';
import { client } from '../../lib/sanity';
import MarketMovers from '../../components/MarketMovers.jsx'; 
import CryptoTable from '../../components/CryptoTable.jsx'; 

// FUNGSI DINAMIS UNTUK MENDAPATKAN SEMUA KATEGORI DARI SANITY
export async function getStaticPaths() {
  // Mengambil daftar kategori unik dari Sanity
  const categories = await client.fetch(`*[_type == "post" && defined(category)].category`);
  const uniqueCategories = [...new Set(categories)];

  return uniqueCategories.map((cat) => ({
    params: { category: cat },
  }));
}

const { category } = Astro.params;

const getOptimizedImageUrl = (url: string, width = 800, height = 500) => 
  url ? `${url}?w=${width}&h=${height}&fit=crop&auto=format&q=80` : '';

const formatDate = (date: string) => {
  return new Date(date).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
};

const posts = await client.fetch(
  `*[_type == "post" && category == $category]|order(publishedAt desc)[0...10]{
    title, slug, publishedAt, 
    "imageUrl": image.asset->url,
    "authorName": authors[0]->name,
    excerpt,
    "bodyText": pt::text(body)
  }`, 
  { category }
);

const trending = await client.fetch(
  `*[_type == "post"]|order(publishedAt desc)[0...5]{title, slug, "imageUrl": image.asset->url}`
);

let topGainers = [];
let topLosers = [];

try {
  const marketResponse = await fetch('https://api.coingecko.com/api/v3/coins/markets?vs_currency=idr&order=market_cap_desc&per_page=20&sparkline=false');
  const allCoins = await marketResponse.json();
  
  topGainers = [...allCoins].sort((a, b) => b.price_change_percentage_24h - a.price_change_percentage_24h).slice(0, 4);
  topLosers = [...allCoins].sort((a, b) => a.price_change_percentage_24h - b.price_change_percentage_24h).slice(0, 4);
} catch (e) {
  console.error("Gagal memuat data pasar:", e);
}

const topTrending = trending[0];
const otherTrending = trending.slice(1, 5);
const heroPost = posts[0];
const gridPosts = posts.slice(1, 3);
const bottomPosts = posts.slice(3, 6);
const listPosts = posts.slice(6, 10);

const categoryDesc = {
  dunia: "Semua tentang dunia terkini dan peristiwa global.",
  crypto: "Semua tentang dunia aset kripto dan blockchain.",
  rwa: "Semua tentang dunia aset dunia nyata (Real World Assets).",
  price: "Semua tentang dunia pergerakan harga dan analisis pasar."
}[category] || "Berita terbaru seputar topik ini.";
---

<Layout title={`Berita ${category.charAt(0).toUpperCase() + category.slice(1)}`}>
  <main class="max-w-[1400px] mx-auto py-8 px-4 md:py-10 md:px-6">
    
    <header class="mb-8 border-b border-gray-200 pb-6">
      <h1 class="text-3xl md:text-4xl font-extrabold text-gray-900 capitalize tracking-tight">Berita {category}</h1>
      <p class="text-gray-500 mt-3 text-base md:text-lg">{categoryDesc}</p>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-12 mb-16">
      
      <div class="lg:col-span-2 space-y-10">
        {heroPost && (
          <article class="group">
            <a href={`/posts/${heroPost.slug?.current}`} class="relative block w-full h-[280px] md:h-[450px] rounded-2xl overflow-hidden bg-gray-900">
              <img src={getOptimizedImageUrl(heroPost.imageUrl, 1200, 800)} alt={heroPost.title} class="w-full h-full object-cover opacity-80 transition-transform duration-700 group-hover:scale-105" />
              <div class="absolute bottom-0 left-0 p-6 w-full bg-gradient-to-t from-black/90 to-transparent">
                <h2 class="text-xl md:text-3xl font-bold text-white leading-snug">{heroPost.title}</h2>
                <p class="text-xs text-gray-300 mt-2">{formatDate(heroPost.publishedAt)}</p>
              </div>
            </a>
          </article>
        )}

        <div class="grid sm:grid-cols-2 gap-6">
          {gridPosts.map((post: any) => (
            <article class="group">
              <a href={`/posts/${post.slug?.current}`} class="block aspect-video overflow-hidden rounded-xl mb-3 bg-gray-100">
                <img src={getOptimizedImageUrl(post.imageUrl, 600, 400)} alt={post.title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
              </a>
              <a href={`/posts/${post.slug?.current}`} class="text-lg font-bold text-gray-900 leading-snug group-hover:text-blue-600">{post.title}</a>
            </article>
          ))}
        </div>
      </div>

      <aside class="space-y-8 lg:border-l lg:border-gray-200 lg:pl-10 border-t pt-8 lg:pt-0 border-gray-200">
        
        <section>
           <CryptoTable 
              client:visible 
              value={{ 
                title: "Market Update", 
                coins: ["bitcoin", "ethereum", "solana", "binancecoin", "ripple"] 
              }} 
            />
        </section>

        <section class="bg-gradient-to-br from-blue-600 to-blue-800 p-6 rounded-xl shadow-lg">
          <h3 class="text-xs font-bold uppercase tracking-widest text-white/90 mb-6 border-b border-white/20 pb-2">Trending</h3>
          {topTrending && (
            <article class="group mb-6">
              <a href={`/posts/${topTrending.slug?.current}`} class="block aspect-video overflow-hidden rounded-lg mb-2 bg-blue-900/50">
                <img src={getOptimizedImageUrl(topTrending.imageUrl, 400, 250)} alt={topTrending.title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
              </a>
              <a href={`/posts/${topTrending.slug?.current}`} class="text-base font-bold text-white leading-tight hover:underline">
                {topTrending.title}
              </a>
            </article>
          )}
          <ul class="space-y-5">
            {otherTrending.map((post: any, i: number) => (
              <li class="flex gap-3 group">
                <span class="text-lg font-bold text-blue-300">0{i + 2}</span>
                <a href={`/posts/${post.slug?.current}`} class="text-sm font-semibold text-white leading-snug hover:text-blue-100">
                  {post.title}
                </a>
              </li>
            ))}
          </ul>
        </section>

        {category !== 'dunia' && (
            <MarketMovers 
                client:visible 
                initialActiveData={topGainers} 
                initialGainers={topGainers} 
                initialLosers={topLosers} 
            />
        )}
      </aside>
    </div>

    {bottomPosts.length > 0 && (
      <div class="mb-16">
        <div class="grid md:grid-cols-3 gap-6">
          {bottomPosts.map((post: any) => (
            <article class="group flex flex-col">
              <a href={`/posts/${post.slug?.current}`} class="block aspect-[4/3] overflow-hidden rounded-lg mb-4 bg-gray-100">
                <img src={getOptimizedImageUrl(post.imageUrl, 400, 300)} alt={post.title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" />
              </a>
              <a href={`/posts/${post.slug?.current}`} class="text-base font-bold text-black leading-snug group-hover:text-blue-600">{post.title}</a>
            </article>
          ))}
        </div>
      </div>
    )}

    {listPosts.length > 0 && (
      <section class="border-t border-gray-200 pt-12">
        <h3 class="text-2xl font-bold mb-8">Pembaruan Terakhir</h3>
        <div class="max-w-4xl flex flex-col gap-0">
          {listPosts.map((post: any) => (
            <article class="flex flex-col md:flex-row gap-4 md:gap-6 items-start py-6 border-b border-gray-200 group">
              <a href={`/posts/${post.slug?.current}`} class="w-full md:w-40 h-40 md:h-24 flex-shrink-0 overflow-hidden rounded-md bg-gray-100">
                <img src={getOptimizedImageUrl(post.imageUrl, 300, 200)} alt={post.title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" />
              </a>
              <div class="flex flex-col">
                <a href={`/posts/${post.slug?.current}`} class="text-lg font-bold text-black leading-tight group-hover:text-blue-600">{post.title}</a>
                <p class="text-xs text-gray-400 mt-1 mb-2">{post.authorName || 'Admin'} • {formatDate(post.publishedAt)}</p>
                <p class="text-sm text-gray-600 line-clamp-2">{post.excerpt || post.bodyText || "Baca berita selengkapnya..."}</p>
              </div>
            </article>
          ))}
        </div>
      </section>
    )}
  </main>
</Layout>