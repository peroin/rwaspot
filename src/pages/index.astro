---
import Layout from '../layouts/Layout.astro';
import { client, urlFor } from '../lib/sanity';
import ArticleCard from '../components/ArticleCard.astro';
import CryptoTable from '../components/CryptoTable.jsx'; 

// MEMBERITAHU ASTRO BAHWA HALAMAN INI HARUS DI-BUILD MENJADI STATIS
export const prerender = true;

const fields = `title, _createdAt, slug, "image": image, category, "author": authors[0]->name`;

const [dataTerbaru, topArticles, dataRekomendasi, pricePosts, cryptoPosts] = await Promise.all([
  client.fetch(`*[_type == "post"] | order(_createdAt desc)[0...5]{title, _createdAt, slug, "author": authors[0]->name}`),
  client.fetch(`*[_type == "post"] | order(_createdAt desc)[0...3]{${fields}}`),
  client.fetch(`*[_type == "post"] | order(_createdAt desc)[5...9]{${fields}}`),
  client.fetch(`*[_type == "post" && category == "price"] | order(_createdAt desc)[0...4]{${fields}}`),
  client.fetch(`*[_type == "post" && category == "crypto"] | order(_createdAt desc)[0...6]{${fields}}`)
]);

const getBadgeClass = (cat) => {
  if (!cat) return 'badge-rwa';
  switch(cat.toLowerCase()) {
    case 'crypto': return 'badge-crypto';
    case 'price': return 'badge-price';
    case 'dunia': return 'badge-dunia';
    default: return 'badge-rwa';
  }
};
---

<Layout title="Beranda | RWADaily">
  <style is:global>
    /* Mengubah warna hover default ke Amber-600 */
    main a:hover { color: #d97706 !important; transition: color 0.3s ease; }
  </style>

  <main class="w-full px-4 md:px-6 py-8 bg-white text-black font-sans">
    
    <div class="flex flex-col lg:grid lg:grid-cols-12 gap-8">
      
      {/* SEKSI TERBARU */}
      <section class="lg:col-span-3 lg:border-r border-gray-200 lg:pr-6 order-2 lg:order-1">
        <h2 class="text-[11px] font-bold uppercase tracking-[0.2em] border-b border-black pb-1 mb-4">Terbaru</h2>
        <div class="space-y-5">
          {dataTerbaru.map((post) => (
            <div class="border-b border-gray-200 pb-4 group">
              <div class="flex items-center gap-2 mb-1">
                <span class="text-[10px] font-bold text-black uppercase tracking-widest">{post.author || "Penulis"}</span>
                <span class="text-[10px] font-medium text-gray-400">• {new Date(post._createdAt).toLocaleDateString('id-ID')}</span>
              </div>
              <a href={`/posts/${post.slug?.current}`} class="text-base font-medium leading-normal !text-black block title-hover">
                {post.title}
              </a>
            </div>
          ))}
        </div>
      </section>

      {/* SEKSI TOP BERITA */}
      <section class="col-span-12 lg:col-span-6 order-1 lg:order-2">
        <h2 class="text-[11px] font-bold uppercase tracking-[0.2em] border-b border-black pb-1 mb-6">Top Berita</h2>
        
        {topArticles[0] && (
          <article class="mb-6">
            <div class="relative w-full aspect-video rounded-xl overflow-hidden bg-gray-100 mb-4 card-hover">
              <a href={`/posts/${topArticles[0].slug?.current}`}>
                <img src={urlFor(topArticles[0].image).width(800).format('webp').url()} alt={topArticles[0].title} class="w-full h-full object-cover transition-transform duration-500 hover:scale-105" loading="lazy" />
              </a>
              <div class="hidden lg:block absolute bottom-0 left-0 p-6 bg-gradient-to-t from-black/90 to-transparent w-full">
                <a href={`/posts/${topArticles[0].slug?.current}`} class="block text-2xl font-bold text-white leading-tight">
                  {topArticles[0].title}
                </a>
                <p class="text-xs mt-2 font-bold uppercase tracking-wide text-white/80">Oleh {topArticles[0].author || "Penulis"}</p>
              </div>
            </div>
          </article>
        )}

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-6">
          {topArticles.slice(1, 3).map((post) => <ArticleCard post={post} />)}
        </div>
      </section>

      {/* SEKSI REKOMENDASI */}
      <aside class="col-span-12 lg:col-span-3 lg:border-l border-gray-200 lg:pl-6 order-3">
        <section class="bg-gradient-to-br from-blue-600 to-blue-800 p-6 rounded-xl shadow-lg mb-8">
          <h3 class="text-[11px] font-bold uppercase tracking-[0.2em] border-b border-white/20 text-white/90 pb-1 mb-4">Rekomendasi</h3>
          <div class="space-y-5">
            {dataRekomendasi.map((post) => (
              <div class="flex gap-3 items-start border-b border-white/10 pb-4">
                <div class="flex flex-col">
                  <span class={getBadgeClass(post.category)}>{post.category || "RWA"}</span>
                  <span class="text-[9px] text-white/60 font-bold mt-1">{post.author || "Penulis"}</span>
                </div>
                <a href={`/posts/${post.slug?.current}`} class="text-sm font-semibold leading-snug !text-white hover:!text-amber-200">{post.title}</a>
              </div>
            ))}
          </div>
        </section>

        <div class="sticky top-8">
          <CryptoTable client:visible value={{ title: "Market Update", coins: ["bitcoin", "ethereum", "solana", "binancecoin", "ripple"] }} />
        </div>
      </aside>
    </div>

    {/* BERITA KRIPTO */}
    <section class="mt-12 border-t border-gray-200 pt-8">
      <h2 class="text-[11px] font-bold uppercase tracking-[0.2em] border-b border-black pb-4 mb-6">Berita Kripto</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-8">
        <div class="lg:col-span-3 flex flex-col gap-6">
            {cryptoPosts.slice(0, 1).map(post => <ArticleCard post={post} />)}
            <div class="flex flex-col gap-4">
                {cryptoPosts.slice(1, 3).map(post => (
                    <a href={`/posts/${post.slug?.current}`} class="group block text-sm border-b border-gray-200 pb-2">
                        <span class={getBadgeClass(post.category) + " mr-2"}>{post.category}</span>
                        {post.title} 
                    </a>
                ))}
            </div>
        </div>
        <div class="lg:col-span-6">
          {cryptoPosts[3] && (
             <article class="group">
               <a href={`/posts/${cryptoPosts[3].slug?.current}`} class="block w-full aspect-video bg-gray-100 rounded-xl overflow-hidden mb-4 card-hover">
                  <img src={urlFor(cryptoPosts[3].image).width(800).format('webp').url()} alt={cryptoPosts[3].title} class="w-full h-full object-cover transition-transform duration-500 hover:scale-105" loading="lazy" />
               </a>
               <a href={`/posts/${cryptoPosts[3].slug?.current}`} class="font-bold text-lg leading-tight block title-hover">{cryptoPosts[3].title}</a>
             </article>
          )}
        </div>
        <div class="lg:col-span-3 flex flex-col gap-6">
            {cryptoPosts.slice(4, 5).map(post => <ArticleCard post={post} />)}
            <div class="flex flex-col gap-4">
                {cryptoPosts.slice(5, 7).map(post => (
                    <a href={`/posts/${post.slug?.current}`} class="group block text-sm border-b border-gray-200 pb-2">
                        <span class={getBadgeClass(post.category) + " mr-2"}>{post.category}</span>
                        {post.title} 
                    </a>
                ))}
            </div>
        </div>
      </div>
    </section>

    {/* ANALISIS HARGA */}
    <section class="mt-16 pt-8 border-t border-gray-200">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-[11px] font-bold uppercase tracking-[0.2em]">Analisis Harga</h2>
        <span class="h-px flex-grow bg-gray-200 ml-4"></span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {pricePosts.map((post) => (
          <div class="flex flex-col gap-2">
            <span class={getBadgeClass(post.category) + " self-start"}>{post.category}</span>
            <ArticleCard post={post} />
          </div>
        ))}
      </div>
    </section>
  </main>
</Layout>