---
import Layout from '../layouts/Layout.astro';
import { client, urlFor } from '../lib/sanity';
import ArticleCard from '../components/ArticleCard.astro';

const fields = `title, _createdAt, slug, "image": image, category, "author": authors[0]->name`;

const [dataTerbaru, topArticles, dataRekomendasi, pricePosts, cryptoPosts] = await Promise.all([
  client.fetch(`*[_type == "post"] | order(_createdAt desc)[0...5]{title, _createdAt, slug, "author": authors[0]->name}`),
  client.fetch(`*[_type == "post"] | order(_createdAt desc)[0...3]{${fields}}`),
  client.fetch(`*[_type == "post"] | order(_createdAt desc)[5...9]{${fields}}`),
  client.fetch(`*[_type == "post" && category == "price"] | order(_createdAt desc)[0...4]{${fields}}`),
  client.fetch(`*[_type == "post" && category == "crypto"] | order(_createdAt desc)[0...6]{${fields}}`)
]);
---

<Layout title="Beranda | RWADaily">
  <style is:global>
    a:hover, a:focus, a:active {
      color: black !important;
    }
  </style>

  <main class="w-full px-6 py-8 bg-white text-black font-sans">
    
    <div class="grid grid-cols-12 gap-6">
      <section class="col-span-12 lg:col-span-3 border-r border-gray-200 pr-6">
        <h2 class="text-[11px] font-bold uppercase tracking-[0.2em] border-b border-black pb-1 mb-4">Terbaru</h2>
        <div class="space-y-5">
          {dataTerbaru.map((post) => (
            <div class="border-b border-gray-200 pb-4 group">
              <div class="flex items-center gap-2 mb-1">
                <span class="text-[10px] font-bold text-black uppercase tracking-widest">{post.author || "Penulis"}</span>
                <span class="text-[10px] font-medium text-gray-400">• {new Date(post._createdAt).toLocaleDateString('id-ID')}</span>
              </div>
              <a href={`/posts/${post.slug?.current}`} class="text-base font-medium leading-normal !text-black hover:!text-black block">
                {post.title}
              </a>
            </div>
          ))}
        </div>
      </section>

      <section class="col-span-12 lg:col-span-6">
        <div class="border-b border-black mb-6">
          <h2 class="text-[11px] font-bold uppercase tracking-[0.2em] pb-1">Top Berita</h2>
        </div>
        
        {topArticles[0] && (
          <div class="group relative w-full aspect-video cursor-pointer mb-6 overflow-hidden rounded-2xl bg-gray-100">
            <img src={urlFor(topArticles[0].image).width(800).format('webp').url()} alt={topArticles[0].title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
            <div class="absolute bottom-0 left-0 w-full p-8 bg-gradient-to-t from-black/90 to-transparent">
              <a href={`/posts/${topArticles[0].slug?.current}`} class="block text-2xl font-bold text-white leading-tight hover:!text-white">
                {topArticles[0].title}
              </a>
              <p class="text-white/80 text-sm mt-2 font-bold uppercase tracking-wide">Oleh {topArticles[0].author || "Penulis"}</p>
            </div>
          </div>
        )}

        <div class="grid grid-cols-2 gap-6 mb-6">
          {topArticles.slice(1, 3).map((post) => <div class="text-black hover:text-black"><ArticleCard post={post} /></div>)}
        </div>
      </section>

      <aside class="col-span-12 lg:col-span-3 border-l border-gray-200 pl-6">
        <h3 class="text-[11px] font-bold uppercase tracking-[0.2em] border-b border-black pb-1 mb-4">Rekomendasi</h3>
        <div class="space-y-5">
          {dataRekomendasi.map((post) => (
            <div class="flex gap-3 items-start group cursor-pointer border-b border-gray-200 pb-4">
              <div class="flex flex-col">
                <span class="text-[11px] font-bold text-black uppercase tracking-widest mt-0.5">{post.category ? post.category.toUpperCase() : "RWA"}</span>
                <span class="text-[9px] text-gray-400 font-bold">{post.author || "Penulis"}</span>
              </div>
              <a href={`/posts/${post.slug?.current}`} class="text-sm font-semibold leading-snug !text-black hover:!text-black mt-0.5">{post.title}</a>
            </div>
          ))}
        </div>
      </aside>
    </div>

    <section class="mt-12 border-t border-gray-200 pt-8">
      <div class="border-b border-black mb-6"><h2 class="text-[11px] font-bold uppercase tracking-[0.2em] pb-1">Berita Kripto</h2></div>
      <div class="grid grid-cols-12 gap-6 items-start">
        <div class="col-span-12 lg:col-span-3 flex flex-col gap-6">
            {cryptoPosts.slice(0, 1).map(post => <div class="text-black"><ArticleCard post={post} /></div>)}
            <div class="flex flex-col gap-4">
                {cryptoPosts.slice(1, 3).map(post => (
                    <a href={`/posts/${post.slug?.current}`} class="group block text-sm border-b border-gray-200 hover:border-black pb-2 !text-black hover:!text-black">
                        {post.title} 
                        <span class="block text-[9px] text-gray-400 mt-1 uppercase font-bold">{post.author}</span>
                    </a>
                ))}
            </div>
        </div>
        <div class="col-span-12 lg:col-span-6">
          {cryptoPosts[3] && (
             <a href={`/posts/${cryptoPosts[3].slug?.current}`} class="relative block w-full aspect-video bg-gray-100 rounded-xl overflow-hidden group">
                <img src={urlFor(cryptoPosts[3].image).width(800).format('webp').url()} alt={cryptoPosts[3].title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
                <div class="absolute bottom-0 left-0 w-full p-8 bg-gradient-to-t from-black/90 to-transparent">
                  <h3 class="font-bold text-lg text-white leading-tight">{cryptoPosts[3].title}</h3>
                  <p class="text-white/80 text-xs mt-2 uppercase font-bold tracking-widest">Oleh {cryptoPosts[3].author || "Penulis"}</p>
                </div>
             </a>
          )}
        </div>
        <div class="col-span-12 lg:col-span-3 flex flex-col gap-6">
            {cryptoPosts.slice(4, 5).map(post => <div class="text-black"><ArticleCard post={post} /></div>)}
            <div class="flex flex-col gap-4">
                {cryptoPosts.slice(5, 7).map(post => (
                    <a href={`/posts/${post.slug?.current}`} class="group block text-sm border-b border-gray-200 hover:border-black pb-2 !text-black hover:!text-black">
                        {post.title} 
                        <span class="block text-[9px] text-gray-400 mt-1 uppercase font-bold">{post.author}</span>
                    </a>
                ))}
            </div>
        </div>
      </div>
    </section>

    <section class="mt-12 border-t border-gray-200 pt-8">
      <div class="border-b border-black mb-6"><h2 class="text-[11px] font-bold uppercase tracking-[0.2em] pb-1">Analisis Harga</h2></div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {pricePosts.map((post) => <div class="text-black"><ArticleCard post={post} /></div>)}
      </div>
    </section>
  </main>
</Layout>