---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';

const { title, description, image } = Astro.props;

const siteName = "RWASpot";
const pageTitle = title ? `${title} | ${siteName}` : siteName;

const schema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": siteName,
  "url": Astro.site ? Astro.site.href : "https://rwadaily.biz.id/",
  "potentialAction": {
    "@type": "SearchAction",
    "target": (Astro.site ? Astro.site.href : "https://rwadaily.biz.id/") + "search?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
};
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <title>{pageTitle}</title>

    {/* Preload Font */}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'">
    
    {/* Penundaan Loading AdSense */}
    <script is:inline>
      window.addEventListener('load', () => {
        setTimeout(() => {
          const ads = document.createElement('script');
          ads.async = true;
          ads.src = "https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3916515190909203";
          ads.crossOrigin = "anonymous";
          document.head.appendChild(ads);
        }, 3000);
      });
    </script>
    
    <meta name="keywords" content="RWA, Crypto, Saham, Berita Ekonomi, RWASpot" />
    <meta name="robots" content="index, follow" />
    
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png">
    <link rel="manifest" href="/site.webmanifest">
    
    <meta name="theme-color" content="#1a1c24" />
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black">
    <meta name="apple-mobile-web-app-title" content={siteName}>
    
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    
    <SEO title={title} description={description} image={image} siteName={siteName} />
    
    <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>

    <style is:global>
      [x-cloak] { display: none !important; }
      
      body { 
        text-rendering: optimizeLegibility; 
        -webkit-font-smoothing: antialiased; 
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        font-display: swap; 
      }

      main a:not(.text-white):not(.text-white *):not(footer *),
      main a:not(.text-white):not(.text-white *):not(footer *):hover {
        color: black !important;
        transition: color 0.2s ease;
      }
    </style>
    
    <slot name="head" />
  </head>

  <body class="bg-gray-50 min-h-screen flex flex-col">
    <Navbar />
    
    <main class="flex-grow font-sans">
      <slot /> 
    </main>

    <Footer />
  </body>
</html>