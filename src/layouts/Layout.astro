---
// src/layouts/Layout.astro
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';

// Mengambil props dari halaman pemanggil
const { title, description, image } = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Title statis/dinamis -->
    <title>{title ? `${title} | RWASpot` : "RWASpot"}</title>
    
    <!-- Meta Keywords (SEO statis) -->
    <meta name="keywords" content="RWA, Crypto, Saham, Berita Ekonomi, RWASpot" />
    
    <!-- Favicon & PWA Icons (Sinkron dengan file di folder /public/) -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png">
    <link rel="manifest" href="/site.webmanifest">
    
    <!-- PWA Meta Tags -->
    <meta name="theme-color" content="#1a1c24" />
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black">
    <meta name="apple-mobile-web-app-title" content="RWASpot">
    
    <!-- Meta SEO Tambahan -->
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={Astro.url.href} />
    
    <!-- Panggil Komponen SEO yang telah direvisi -->
    <SEO title={title} description={description} image={image} />
    
    <!-- Alpine.js untuk fitur Menu Hamburger -->
    <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>

    <!-- Style tambahan untuk mencegah flicker menu -->
    <style is:global>
      [x-cloak] { display: none !important; }
    </style>
    
    <!-- Slot ini memungkinkan Anda menyisipkan JSON-LD atau style khusus di halaman tertentu -->
    <slot name="head" />
  </head>

  <body class="bg-gray-50 min-h-screen flex flex-col">
    <Navbar />
    
    <main class="flex-grow">
      <slot /> 
    </main>

    <Footer />
  </body>
</html>