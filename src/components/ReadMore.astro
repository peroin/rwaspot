---
// src/components/ReadMore.astro
const { node } = Astro.props;
const post = node?.post;

if (!post) return null;

const slug = typeof post.slug === 'string' ? post.slug : post.slug?.current;
---

<div class="my-6 p-4 border-l-4 border-red-600 bg-gray-50 rounded-r-lg hover:bg-gray-100 transition-colors shadow-sm">
  <span class="flex items-center gap-2 text-xs font-black text-red-600 uppercase tracking-wider mb-2">
    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
      <path d="M10 12a2 2 0 100-4 2 2 0 000 4z"/>
      <path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd"/>
    </svg>
    Baca Juga:
  </span>
  
  <a href={`/posts/${slug}`} class="block group">
    <h3 class="text-sm md:text-base font-semibold text-gray-900 leading-snug group-hover:text-red-700 transition-colors">
      {post.title}
    </h3>
  </a>
</div>