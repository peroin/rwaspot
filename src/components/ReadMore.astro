---
const { node } = Astro.props;
const post = node?.post;

if (!post) return null;

const slug = typeof post.slug === 'string' ? post.slug : post.slug?.current;
---

<div class="my-2 px-2 py-1 border border-gray-100 bg-gray-50 rounded hover:border-red-200 transition-colors">
  <span class="text-[6px] font-bold text-red-600 uppercase tracking-widest block leading-none mb-0.5">
    Baca Juga
  </span>
  
  <a href={`/posts/${slug}`} class="block group">
    <h3 class="text-[10px] font-medium text-gray-800 leading-tight group-hover:text-red-600 transition-colors">
      {post.title}
    </h3>
  </a>
</div>