---
const { type = "banner" } = Astro.props; 

const ads = {
  banner: {
    key: "0d1e33159744964659cb9d2f727263fa",
    src: "//www.highperformanceformat.com/0d1e33159744964659cb9d2f727263fa/invoke.js"
  },
  square: {
    key: "c638c69d43e19fdfba16a1c280a85a01",
    src: "//www.highperformanceformat.com/c638c69d43e19fdfba16a1c280a85a01/invoke.js"
  }
};

const currentAd = ads[type as keyof typeof ads];
---

<div class={`adsterra-container ${type}`}>
  <script is:inline define:vars={{ key: currentAd.key }}>
    atOptions = {
      'key' : key,
      'format' : 'iframe',
      'height' : key === "0d1e33159744964659cb9d2f727263fa" ? 90 : 250,
      'width' : key === "0d1e33159744964659cb9d2f727263fa" ? 728 : 300,
      'params' : {}
    };
  </script>
  <script is:inline src={currentAd.src}></script>
</div>

<style>
  .adsterra-container {
    display: flex;
    justify-content: center;
    margin: 20px 0;
    width: 100%;
    /* Mencegah konten meluap keluar */
    overflow: hidden; 
  }

  /* Memaksa iframe agar tidak melebihi lebar layar dan tetap proporsional */
  :global(.adsterra-container iframe) {
    max-width: 100% !important;
    width: 100% !important;
    height: auto !important;
  }
</style>