---
const navLinks = ["Home", "Dunia", "Crypto", "RWA", "Price"];
---

<nav class="bg-[#1a1c24] text-white py-4 sticky top-0 z-50 shadow-lg border-b border-gray-800">
  <div class="max-w-7xl mx-auto px-4 flex justify-between items-center">
    
    <!-- Logo -->
    <a href="/" class="text-2xl font-bold italic tracking-tighter">
      <span class="text-red-600">RWA</span><span class="text-white">SPOT</span>
    </a>
    
    <!-- Nav Links -->
    <div class="hidden md:flex gap-6 font-medium text-sm">
      {navLinks.map(link => (
        <a href={link === "Home" ? "/" : `/${link.toLowerCase()}`} class="hover:text-red-500 transition-colors">
          {link}
        </a>
      ))}
    </div>

    <!-- Search -->
    <div class="relative flex items-center">
      <input 
        id="search-input"
        type="search" 
        placeholder="Cari berita..." 
        autocomplete="off"
        class="bg-gray-800 text-sm px-4 py-1.5 rounded-full outline-none focus:ring-2 focus:ring-red-600 border border-gray-700 w-32 md:w-64 transition-all" 
      />
      
      <!-- Container Hasil -->
      <div id="search-results" class="absolute top-12 right-0 w-80 bg-white/95 backdrop-blur-sm text-gray-900 rounded-2xl shadow-2xl hidden overflow-hidden border border-gray-100 ring-1 ring-black/5 z-50 transition-all duration-300">
        <ul id="results-list" class="max-h-80 overflow-y-auto py-2"></ul>
        <div class="px-4 py-2 bg-gray-50 border-t border-gray-100 text-[10px] text-gray-400 uppercase tracking-widest font-bold">
          RWASpot Search
        </div>
      </div>
    </div>
  </div>
</nav>

<script is:inline>
  const searchInput = document.getElementById('search-input');
  const resultsDiv = document.getElementById('search-results');
  const resultsList = document.getElementById('results-list');

  function highlightText(text, query) {
    if (!query) return text;
    const regex = new RegExp(`(${query})`, 'gi');
    return text.replace(regex, '<span class="bg-yellow-200 font-bold px-0.5 rounded">$1</span>');
  }

  let debounceTimer;

  searchInput.addEventListener('input', (e) => {
    const val = e.target.value.trim();
    clearTimeout(debounceTimer);
    
    if (val.length < 2) {
      resultsDiv.classList.remove('hidden');
      resultsList.innerHTML = `
        <li class="px-5 py-2 text-[10px] font-bold text-gray-400 uppercase tracking-widest">Trending Now</li>
        <li><a href="/crypto" class="block px-5 py-3 text-sm hover:bg-red-50 hover:text-red-700 transition">Analisis Harga BTC</a></li>
        <li><a href="/rwa" class="block px-5 py-3 text-sm hover:bg-red-50 hover:text-red-700 transition">Tokenisasi Aset Nyata</a></li>
      `;
      return;
    }

    debounceTimer = setTimeout(async () => {
      try {
        const res = await fetch(`/api/search.json?q=${encodeURIComponent(val)}`);
        const data = await res.json();

        resultsDiv.classList.remove('hidden');

        if (data.length > 0) {
          resultsList.innerHTML = data.map(post => {
            // Mengambil data authors dari JSON, fallback ke 'Admin' jika tidak ada
            const authors = post.authors && post.authors.length > 0 ? post.authors.join(' & ') : 'Admin';
            
            return `
              <li class="group">
                <a href="/posts/${post.slug}" class="block px-5 py-3 text-sm transition-colors duration-200 hover:bg-red-50 hover:text-red-700">
                  <div class="flex items-start gap-3">
                    <svg class="w-4 h-4 mt-0.5 text-gray-400 group-hover:text-red-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
                    <div>
                      <div class="font-medium leading-tight">${highlightText(post.title, val)}</div>
                      <div class="text-[10px] text-gray-400 mt-1 uppercase tracking-wider font-semibold">By ${authors}</div>
                    </div>
                  </div>
                </a>
              </li>
            `;
          }).join('');
        } else {
          resultsList.innerHTML = `<li class="px-5 py-4 text-sm text-gray-500">Tidak ditemukan hasil untuk "${val}".</li>`;
        }
      } catch (err) {
        console.error("Gagal melakukan pencarian:", err);
      }
    }, 400); 
  });

  // Event klik di luar search untuk menutup dropdown
  document.addEventListener('click', (e) => {
    if (!searchInput.contains(e.target)) resultsDiv.classList.add('hidden');
  });

  searchInput.addEventListener('focus', () => {
    if (searchInput.value.length < 2) {
        resultsDiv.classList.remove('hidden');
        resultsList.innerHTML = `
            <li class="px-5 py-2 text-[10px] font-bold text-gray-400 uppercase tracking-widest">Saran Pencarian</li>
            <li><a href="/crypto" class="block px-5 py-3 text-sm hover:bg-red-50 hover:text-red-700 transition">Tren Crypto 2026</a></li>
            <li><a href="/rwa" class="block px-5 py-3 text-sm hover:bg-red-50 hover:text-red-700 transition">Top Aset RWA</a></li>
        `;
    }
  });
</script>