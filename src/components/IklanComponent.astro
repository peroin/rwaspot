---
// src/components/IklanComponent.astro
interface Props {
  imageUrl: string;
  link: string;
  label?: string; // Opsional: untuk mengganti teks "Advertisement"
}

const { imageUrl, link, label = "Advertisement" } = Astro.props;
---

<div class="my-10 w-full flex flex-col items-center">
  <p class="text-[10px] text-gray-400 uppercase tracking-widest mb-2">{label}</p>
  <a href={link} target="_blank" rel="noopener noreferrer" class="block w-full max-w-2xl overflow-hidden rounded-xl shadow-md hover:shadow-lg transition-shadow duration-300">
    <img 
      src={imageUrl} 
      alt="Iklan" 
      class="w-full h-auto object-cover" 
      loading="lazy"
    />
  </a>
</div>