---
// src/components/ShareButton.astro
---

<button id="shareButton" class="flex items-center gap-2 px-6 py-3 bg-gray-900 text-white rounded-full hover:bg-gray-700 transition-all font-medium text-sm">
  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="18" cy="5" r="3"></circle>
    <circle cx="6" cy="12" r="3"></circle>
    <circle cx="18" cy="19" r="3"></circle>
    <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
    <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
  </svg>
  Bagikan Artikel
</button>

<script>
  const shareButton = document.getElementById('shareButton');

  shareButton?.addEventListener('click', async () => {
    // 1. Cek apakah browser mendukung fitur Native Share (biasanya HP)
    if (navigator.share) {
      try {
        await navigator.share({
          title: document.title,
          text: 'Baca artikel menarik ini di RWASpot!',
          url: window.location.href,
        });
      } catch (err) {
        console.log('Share dibatalkan:', err);
      }
    } 
    // 2. Jika tidak mendukung (biasanya Desktop), salin link ke clipboard
    else {
      try {
        await navigator.clipboard.writeText(window.location.href);
        alert('Link artikel berhasil disalin!');
      } catch (err) {
        console.error('Gagal menyalin link:', err);
      }
    }
  });

  // Hapus baris penyembunyian tombol agar tetap muncul di Desktop
  // if (!navigator.share) {
  //   shareButton!.style.display = 'none';
  // }
</script>