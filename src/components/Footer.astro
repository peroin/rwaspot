---
// src/components/Footer.astro
import { Icon } from 'astro-icon/components';
---

<footer class="bg-gray-900 text-gray-300 py-16 px-4 border-t-4 border-red-600">
  <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-12">
    
    <!-- Bagian 1: Tentang RWASpot -->
    <div>
      <h3 class="text-white text-lg font-bold mb-4">Tentang RWASpot</h3>
      <p class="text-sm leading-relaxed mb-6">
        RWASpot adalah portal berita terdepan yang berfokus pada Real World Assets (RWA), saham, dan ekosistem crypto. Kami berkomitmen memberikan analisis mendalam bagi investor cerdas.
      </p>
      
      <div class="text-xs text-gray-400 mb-6">
        <p class="font-semibold text-gray-300">Kantor Redaksi:</p>
        <p>Plaza Asia, Jl. K.H.Z. Mustofa No. 326,<br/> Tasikmalaya, Jawa Barat 46126, Indonesia.</p>
      </div>

      <!-- Sosial Media Ikon -->
      <div class="flex gap-4">
        <a href="https://www.linkedin.com/in/rwadailybiz/" class="text-gray-400 hover:text-white transition-colors" aria-label="LinkedIn">
          <Icon name="mdi:linkedin" class="w-6 h-6" />
        </a>
        <a href="https://www.instagram.com/rwaspot" class="text-gray-400 hover:text-white transition-colors" aria-label="Instagram">
          <Icon name="mdi:instagram" class="w-6 h-6" />
        </a>
        <a href="https://x.com/Rwadailybiz" class="text-gray-400 hover:text-white transition-colors" aria-label="X (Twitter)">
          <Icon name="mdi:twitter" class="w-6 h-6" />
        </a>
        <a href="https://www.facebook.com/share/1HoCmT2TS1/" class="text-gray-400 hover:text-white transition-colors" aria-label="Facebook">
          <Icon name="mdi:facebook" class="w-6 h-6" />
        </a>
      </div>
    </div>

    <!-- Bagian 2: Tim Editorial -->
    <div>
      <h3 class="text-white text-lg font-bold mb-4">Tim Editorial</h3>
      <div class="space-y-6">
        {[
          { name: "Iqbal Maulana", role: "Pakar Saham & Crypto", fb: "https://www.facebook.com/share/18kcTm8hKy/", ig: "https://www.instagram.com/iqbalmaulanas_?igsh=dGQyZTducGI2NXMw" },
          { name: "Siti Rohimah", role: "Riset Data Saham & Crypto", fb: "https://www.facebook.com/share/1JVtw65hVv/", ig: "https://www.instagram.com/sitirohimah08_?igsh=MWpocTJkaTl1MHF5dQ==" },
          { name: "Galuh Purnama", role: "Analis Pasar", ig: "https://www.instagram.com/luhhhhh666?igsh=MXh5cjBuanBidHhvdw==" }
        ].map((member) => (
          <div class="flex items-center justify-between group">
            <div>
              <p class="text-white font-semibold text-sm">{member.name}</p>
              <p class="text-xs text-gray-500 group-hover:text-gray-300 transition-colors">{member.role}</p>
            </div>
            <div class="flex gap-3">
              {member.fb && <a href={member.fb} target="_blank" rel="noopener noreferrer" class="text-blue-500 hover:text-white"><Icon name="mdi:facebook" class="w-4 h-4" /></a>}
              {member.ig && <a href={member.ig} target="_blank" rel="noopener noreferrer" class="text-pink-500 hover:text-white"><Icon name="mdi:instagram" class="w-4 h-4" /></a>}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Bagian 3: Navigasi & Legal -->
    <div>
      <h3 class="text-white text-lg font-bold mb-4">Pintasan</h3>
      <ul class="space-y-3 text-sm">
        <li><a href="/crypto" class="hover:text-red-500 transition-colors flex items-center gap-2"><Icon name="mdi:chevron-right" class="w-4 h-4"/> Berita Crypto</a></li>
        <li><a href="/saham" class="hover:text-red-500 transition-colors flex items-center gap-2"><Icon name="mdi:chevron-right" class="w-4 h-4"/> Analisis Saham</a></li>
        <li><a href="/about" class="hover:text-red-500 transition-colors flex items-center gap-2"><Icon name="mdi:chevron-right" class="w-4 h-4"/> Tentang Kami</a></li>
        <li><a href="/privacy-policy" class="hover:text-red-500 transition-colors flex items-center gap-2"><Icon name="mdi:chevron-right" class="w-4 h-4"/> Kebijakan Privasi</a></li>
        <li><a href="/disclaimer" class="hover:text-red-500 transition-colors flex items-center gap-2"><Icon name="mdi:chevron-right" class="w-4 h-4"/> Disclaimer</a></li>
      </ul>
    </div>
  </div>

  <!-- Copyright -->
  <div class="max-w-7xl mx-auto mt-16 pt-8 border-t border-gray-800 text-center text-xs text-gray-500 px-4">
    <p class="mb-2">© {new Date().getFullYear()} RWASpot — All rights reserved.</p>
    <p>Investasi di bidang crypto dan saham memiliki risiko tinggi. Lakukan riset mandiri.</p>
  </div>
</footer>