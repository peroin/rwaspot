---
// src/components/ArticleCard.astro
import { urlFor } from '../lib/sanity';

interface Props {
  post: {
    title: string;
    slug: { current: string };
    image?: any;
    author?: string;
    category?: string;
  };
  showCategory?: boolean; // Opsional: apakah mau menampilkan kategori?
}

const { post, showCategory = false } = Astro.props;
---

<div class="group flex flex-col h-full border-b border-gray-100 pb-4 transition-all">
  <!-- Image Container -->
  <a href={`/posts/${post.slug?.current}`} class="relative block w-full aspect-video overflow-hidden rounded-xl bg-gray-200 mb-3">
    {post.image ? (
      <img 
        src={urlFor(post.image).width(600).format('webp').url()} 
        alt={post.title} 
        loading="lazy"
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
      />
    ) : (
      <div class="flex h-full w-full items-center justify-center text-gray-400 text-xs">No Image</div>
    )}
  </a>

  <!-- Content -->
  <div class="flex flex-col flex-grow">
    {showCategory && post.category && (
      <span class="text-[10px] font-bold uppercase tracking-widest text-red-600 mb-1">
        {post.category}
      </span>
    )}
    
    <a href={`/posts/${post.slug?.current}`} class="text-sm font-bold leading-snug hover:underline group-hover:text-red-600 transition-colors">
      {post.title}
    </a>
    
    <p class="text-[10px] text-gray-500 mt-2 uppercase font-bold tracking-widest">
      {post.author || "Admin"}
    </p>
  </div>
</div>