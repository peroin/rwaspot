---
// src/components/ArticleBody.astro
const { class: className } = Astro.props;
---

<div class={`prose prose-lg max-w-none 
            px-4 md:px-0 
            prose-p:text-gray-800 prose-p:leading-relaxed 
            
            prose-headings:font-bold prose-headings:text-black 
            prose-headings:tracking-tight
            
            prose-ol:list-decimal prose-ul:list-disc 
            prose-li:marker:text-black
            
            /* Menggunakan ! untuk memaksa warna biru menang atas settingan default */
            prose-a:!text-blue-600 
            prose-a:underline 
            prose-a:decoration-blue-600/30 
            prose-a:underline-offset-4 
            hover:prose-a:!text-blue-800 
            hover:prose-a:decoration-blue-800
            
            prose-img:rounded-2xl prose-img:shadow-sm 
            prose-img:w-full prose-img:h-auto 
            prose-img:object-cover ${className || ""}`}>
  <slot />
</div>