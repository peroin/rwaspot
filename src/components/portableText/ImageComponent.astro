---
const { node } = Astro.props;
// Menambahkan parameter URL untuk optimasi gambar otomatis
const imageUrl = node.asset?.url ? `${node.asset.url}?w=800&auto=format&fm=webp` : "";
---
<img 
  src={imageUrl} 
  alt={node.alt || "Gambar artikel"} 
  loading="lazy"
  class="w-full h-auto rounded-xl mb-10 shadow-md" 
/>