---
// src/components/portableText/ReadMore.astro
const { node } = Astro.props;

// Kita pastikan data ada sebelum dirender
const hasPost = node && node.post && node.post.slug && node.post.slug.current;
---

<div class="p-6 my-8 border border-gray-200 rounded-2xl bg-gray-50 transition-all hover:border-red-200">
  <div class="flex items-center gap-2 mb-2 text-red-600 font-bold uppercase tracking-wider text-xs">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z" />
      <circle cx="12" cy="12" r="3" />
    </svg>
    <span>Baca Juga:</span>
  </div>

  {hasPost ? (
    <a 
      href={`/posts/${node.post.slug.current}`} 
      class="text-lg font-semibold text-gray-900 hover:text-red-600 transition-colors duration-300"
    >
      {node.post.title}
    </a>
  ) : (
    <p class="text-sm text-gray-400 italic">Artikel terkait tidak ditemukan.</p>
  )}
</div>